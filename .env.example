# ==== Обязательное ====
# Токен бота от @BotFather (/mybots → бот → API Token). Никому не пересылай.
BOT_TOKEN=
# Твой числовой Telegram ID (узнать: @userinfobot). Через запятую, если админов несколько.
# Админы получают PRO навсегда, сообщения поддержки, оплаты и уведомления о сбоях ленты.
ADMIN_IDS=
# Контакт поддержки для /terms и сообщений об оплате, например @your_username
SUPPORT_CONTACT=
# Оплата PRO звёздами Telegram. false — кнопки оплаты скрыты.
PAYMENTS_ENABLED=true

# ==== Технические (можно не трогать) ====
# DB_PATH=data/radar.db
# LOG_FILE=data/radar.log
# LOG_LEVEL=INFO
# Как часто читать ленту FL.ru, секунд (не меньше 60)
# POLL_SECONDS=150
# Через сколько минут без данных предупредить админа
# STALE_MINUTES=15
# Сколько дней хранить заказы
# KEEP_DAYS=14
# Прокси для api.telegram.org, если сервер не видит Telegram напрямую (http://user:pass@host:port или socks5://...)
# TELEGRAM_PROXY=
